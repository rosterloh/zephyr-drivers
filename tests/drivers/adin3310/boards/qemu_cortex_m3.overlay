/ {
	aliases {
		adin3310-0 = &adin3310;
	};

	fake_spi: spi@200 {
		status = "okay";
		compatible = "zephyr,spi-emul-controller";
		clock-frequency = <50000000>;
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x200 4>;

		adin3310: adin3310@0 {
			compatible = "adi,adin3310";
			reg = <0>;
			spi-max-frequency = <1000000>;
			port-count = <3>;
			reset-assert-us = <1>;
			reset-deassert-us = <1>;
		};
	};
};
