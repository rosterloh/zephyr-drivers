#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	fake_i2c_bus: i2c@100 {
		compatible = "zephyr,i2c-emul-controller";
		reg = <0x100 4>;
		clock-frequency = <I2C_BITRATE_STANDARD>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		ltr308: ltr308@53 {
			compatible = "liteon,ltr308";
			reg = <0x53>;
			gain = <6>;
			integration-time-ms = <50>;
			measurement-rate-ms = <500>;
		};
	};
};
