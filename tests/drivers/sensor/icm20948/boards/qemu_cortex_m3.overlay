/ {
	fake_i2c_bus: i2c@100 {
		status = "okay";
		compatible = "zephyr,i2c-emul-controller";
		clock-frequency = <100000>;
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x100 4>;

		icm20948: icm20948@68 {
			compatible = "invensense,icm20948";
			reg = <0x68>;
		};
	};
};
