#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	fake_i2c_bus: i2c@100 {
		status = "okay";
		compatible = "zephyr,i2c-emul-controller";
		clock-frequency = <I2C_BITRATE_STANDARD>;
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x100 4>;

		ina3221: ina3221@40 {
			compatible = "ti,ina3221";
			reg = <0x40>;
			/* Channel 3 off, so the decoder has a disabled rail to refuse */
			enable-channel = <1 1 0>;
			shunt-resistors = <10 20 100>;
		};
	};
};
