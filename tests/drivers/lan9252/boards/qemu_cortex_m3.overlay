/ {
	aliases {
		lan9252-0 = &lan9252;
	};

	fake_spi: spi@200 {
		status = "okay";
		compatible = "zephyr,spi-emul-controller";
		clock-frequency = <50000000>;
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x200 4>;

		lan9252: lan9252@0 {
			compatible = "microchip,lan9252";
			reg = <0>;
			spi-max-frequency = <1000000>;
			init-timeout-ms = <20>;
		};
	};
};
