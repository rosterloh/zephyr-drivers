&gpio0 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&timer0 {
	status = "okay";
};

&timer1 {
	status = "okay";
};

&twai {
	/* requires external CAN transceiver or jumper on RX and TX pins for loopback testing */
	status = "disabled";
	pinctrl-0 = <&twai_default>;
	pinctrl-names = "default";
};

&wifi {
	status = "okay";
};

&esp32_bt_hci {
	status = "okay";
};
