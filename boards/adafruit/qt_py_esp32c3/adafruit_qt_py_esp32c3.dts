/dts-v1/;

#include <espressif/esp32c3/esp32c3.dtsi>
// #include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "adafruit_qt_py_esp32c3-pinctrl.dtsi"
#include "seeed_xiao_connector.dtsi"
#include <espressif/partitions_0x0_default.dtsi>

/ {
	model = "Adafruit QT Py ESP32C3";
	compatible = "seeed,xiao-esp32c3";

	chosen {
		zephyr,sram = &sram1;
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,canbus = &twai;
		zephyr,bt-hci = &esp32_bt_hci;
	};

	aliases {
		i2c-0 = &i2c0;
		watchdog0 = &wdt0;
		// led-strip = &led_strip;
		sw0 = &button0;
	};

	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = <&gpio0 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "User button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	stemma_connector: stemma_connector {
		compatible = "stemma-qt-connector";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <0 0 &gpio0 6 0>, /* SCL */
			   <1 0 &gpio0 5 0>; /* SDA */
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&usb_serial {
	status = "okay";
};

zephyr_i2c: &i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
};

&trng0 {
	status = "okay";
};

/*
 * The QT Py ESP32-C3 carries 4 MB. This used to come from
 * <espressif/esp32c3/esp32c3_fx4.dtsi>, the SIP variant header that set flash
 * reg/ranges for the 4 MB part; upstream removed those variant files and moved
 * the sizing into each board, which is why esp32c3_common.dtsi leaves flash0
 * with the comment "reg and ranges are specified in SOC/SIP dtsi" and no reg.
 * Without this the partitions below have nothing to sit in.
 * Same shape as deps/zephyr/boards/espressif/esp32c3_devkitm/esp32c3_devkitm.dts.
 */
&flash0 {
	reg = <0x0 DT_SIZE_M(4)>;
	ranges = <0x0 0x0 DT_SIZE_M(4)>;
};

&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";
};

