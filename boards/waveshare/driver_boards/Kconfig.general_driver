# General Driver for Robots board configuration

config BOARD_GENERAL_DRIVER
	# Was SOC_ESP32_WROOM_32UE_N4, which no longer exists: upstream 8094e612
	# deleted the per-module SoC symbols along with their dtsi files. It was
	# also the wrong variant -- this board carries 16MB, not 4 -- but the
	# symbol only selected SOC_ESP32, so nothing depended on the difference.
	# The flash size now comes from &flash0 in the board devicetree.
	select SOC_ESP32
	# These once guarded on the ros_driver symbols, copy-pasted from that
	# board, so neither select ever fired here. The two board names were two
	# characters apart at the time, which is half of why this board is now
	# called general_driver.
	select SOC_ESP32_PROCPU if BOARD_GENERAL_DRIVER_ESP32_PROCPU
	select SOC_ESP32_APPCPU if BOARD_GENERAL_DRIVER_ESP32_APPCPU
	# partitions_0x1000_amp_16M.dtsi puts slot0 at 0x20000; mark this so
	# Zephyr's USE_DT_CODE_PARTITION can satisfy its dependency when sysbuild
	# enables BOOTLOADER_MCUBOOT.
	select HAS_FLASH_LOAD_OFFSET
