 *
 * partitions_0x2000_default_16M.dtsi with 2 MB image slots, shared by the HP
 * and LP core so their offsets agree.
 *
 * MCUboot sizes its sector table from the slot size
 * (CONFIG_BOOT_MAX_IMG_SECTORS_AUTO). The 16M table's 7936 KB slots make that
 * ~31 KB of .bss, which leaves too little of the bootloader's dram_seg: with
 * logging on, MCUboot overflows it by 812 bytes. 2 MB slots cut the table to
 * 8 KB. Capping BOOT_MAX_IMG_SECTORS instead fails at boot, not build.
 *
 * Everything past 0x461000 (~27.6 MB of the 32 MB flash) is unallocated.
 */

&flash0 {
	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@2000 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x2000 DT_SIZE_K(56)>;
		};

		sys_partition: partition@10000 {
			compatible = "zephyr,mapped-partition";
			label = "sys";
			reg = <0x10000 DT_SIZE_K(64)>;
		};

		slot0_partition: partition@20000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x20000 DT_SIZE_M(2)>;
		};

		slot1_partition: partition@220000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x220000 DT_SIZE_M(2)>;
		};

		slot0_lpcore_partition: partition@420000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0-lpcore";
			reg = <0x420000 DT_SIZE_K(32)>;
		};

		slot1_lpcore_partition: partition@428000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1-lpcore";
			reg = <0x428000 DT_SIZE_K(32)>;
		};

		storage_partition: partition@430000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x430000 DT_SIZE_K(192)>;
		};

		coredump_partition: partition@460000 {
			compatible = "zephyr,mapped-partition";
			label = "coredump";
			reg = <0x460000 DT_SIZE_K(4)>;
		};
	};
};
