/dts-v1/;

#include <espressif/esp32p4/esp32p4_n16r32.dtsi>
#include "esp32p4_nano-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/video/video-interfaces.h>
#include <espressif/partitions_0x2000_default_16M.dtsi>

/*
 * WiFi/BT (out of scope): an on-board ESP32-C6 provides the radio over SDIO
 * (Reset GPIO54, CLK GPIO18, CMD GPIO19, D0-D3 GPIO14-17). Zephyr's esp_hosted
 * driver is SPI-only, so no node is defined here; see doc/index.rst.
 *
 * The MicroSD VDD rail (GPIO45) is default-on in hardware (the vendor demos
 * never drive it), so it is not modelled. GPIO51 is NOT a power rail: the
 * schematic names it PHY_RESET, and it is wired as the IP101's reset - see
 * &phy below.
 *
 * The USB 2.0 HS OTG port lands on a USB-A connector (J2), i.e. it is a host
 * port, so no zephyr_udc0 device-side label is defined. Zephyr can in principle
 * drive it: the SoC's usb_otg node already carries the "snps,dwc2" compatible
 * that drivers/usb/uhc/uhc_dwc2.c binds, so a zephyr_uhc0 label is the route
 * in. Untested on P4 high-speed, hence left disabled.
 */

/ {
	model = "Waveshare ESP32-P4-Nano HP Core";
	compatible = "waveshare,esp32-p4-nano";

	chosen {
		zephyr,sram = &sramhp;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	aliases {
		sw0 = &boot_button;
		watchdog0 = &wdt0;
		sdhc0 = &sdhc0;
		/*
		 * Required by MCUboot's serial-recovery / USB-DFU entrance GPIO:
		 * bootloader/mcuboot/boot/zephyr/io.c derives BUTTON_0_NODE from
		 * this alias and #errors without it. The BOOT button is the only
		 * user button on the board, and holding it is the physical way
		 * back in if an OTA leaves the app unbootable.
		 */
		mcuboot-button0 = &boot_button;
	};

	gpio_keys {
		compatible = "gpio-keys";

		boot_button: button {
			label = "Boot Button";
			gpios = <&gpio1 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};
};

/*
 * The SoC dtsi defaults to 400 MHz, which only exists on v3.x silicon. This
 * board is rev v1.3 (Kconfig.esp32p4_nano selects SOC_ESP32P4_REV_1_3), whose
 * clock generator produces 90/180/360 MHz only. soc/espressif/esp32p4/soc.c
 * BUILD_ASSERTs set membership per revision, so leaving the default here is a
 * build failure; before that assert landed it was a boot failure.
 */
&cpu0 {
	clock-frequency = <DT_FREQ_M(360)>;
};

&cpu1 {
	clock-frequency = <DT_FREQ_M(360)>;
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&trng0 {
	status = "okay";
};

&coretemp {
	status = "okay";
};

/*
 * zephyr_i2c is the conventional label for a board's general-purpose I2C, which
 * samples and shields bind to. On this board i2c0 is also the CSI connector's
 * SCCB bus (GPIO8 SCL / GPIO7 SDA) and drives the on-board ES8311 codec.
 */
zephyr_i2c: &i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
};

&usb_serial {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&dma {
	status = "okay";
};

&dma_axi {
	status = "okay";
};

&ldo {
	status = "okay";

	ldo1@1 {
		regulator-init-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	ldo2@2 {
		regulator-init-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	ldo4@4 {
		regulator-init-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};
};

&sdhc {
	sdhc0: sdhc@0 {
		status = "okay";
		bus-width = <4>;
		max-bus-freq = <40000000>;
		clk-pin = <43>;
		cmd-pin = <44>;
		d0-pin = <39>;
		d1-pin = <40>;
		d2-pin = <41>;
		d3-pin = <42>;

		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

&mdio {
	pinctrl-0 = <&mdio_default>;
	pinctrl-names = "default";
	status = "okay";

	/*
	 * PHY_RESET is GPIO51 (= gpio1 pin 19, since gpio1 starts at GPIO32),
	 * active low, per the board schematic. The in-tree waveshare_esp32p4_eth
	 * board independently uses the same pin.
	 *
	 * Both timing properties are mandatory here, not tuning knobs. phy_mii.c
	 * reads them with DT_INST_PROP_OR(..., 0), so declaring reset-gpios
	 * without them yields gpio assert -> k_busy_wait(0) -> gpio deassert ->
	 * k_msleep(0) -> immediate MDIO read: a zero-width reset pulse and no
	 * settling time, so the PHY's ID registers are read while it is still in
	 * reset. That reads back as "phy_mii: No PHY found at address 1" plus
	 * "eth_esp32: PHY device not ready" and leaves the board with no network
	 * interface at all - strictly worse than declaring no reset line.
	 *
	 * 10 ms assert is the IP101's documented minimum; the 50 ms deassertion
	 * timeout is deliberate margin over its ~10 ms. Values verified on the
	 * sibling ESP32-P4-ETH board. Trim only with a scope on the reset line.
	 */
	phy: ethernet-phy@1 {
		compatible = "ethernet-phy";
		reg = <1>;
		reset-gpios = <&gpio1 19 GPIO_ACTIVE_LOW>;
		reset-assert-duration-us = <10000>;
		reset-deassertion-timeout-ms = <50>;
	};
};

&eth {
	status = "okay";
	phy-handle = <&phy>;
	pinctrl-0 = <&rmii_default>;
	pinctrl-names = "default";
};

/*
 * MIPI CSI-2 camera receiver (host + bridge). The D-PHY uses dedicated silicon
 * pads (no pinctrl) and its clocks are gated by the HAL, so - like the sibling
 * mipi-dsi node upstream - it declares neither. Disabled by default; a shield
 * or overlay enables it and wires the sensor endpoint.
 *
 * The csi_* labels are the contract Zephyr's camera shields bind to, so that
 * boards/shields/raspberry_pi_camera_module_2 works here unmodified rather than
 * each application hand-rolling an IMX219 overlay:
 *
 *   csi_interface     - the receiver, which the shield sets status = "okay"
 *   csi_ep_in         - its input endpoint, which the shield points at the sensor
 *   csi_capture_port  - the video device an app opens, i.e. chosen zephyr,camera
 *   csi_i2c           - the SCCB bus on the CSI connector (below)
 *
 * ST's boards split csi_interface (&dcmipp) from csi_capture_port (&pipe_main)
 * because their capture pipeline is a child node. This receiver is a single
 * video device, so both labels name the same node.
 */
/ {
	soc {
		csi_interface: csi_capture_port: mipi_csi: mipi-csi@5009f000 {
			compatible = "espressif,esp32p4-mipi-csi";
			reg = <0x5009f000 0x800 0x5009f800 0x800>;
			reg-names = "host", "bridge";
			/*
			 * Frame completion is signalled by the DW-GDMA channel
			 * that drains the CSI bridge (one contiguous block per
			 * frame), so the receiver services the DW-GDMA IRQ.
			 */
			interrupts = <DW_GDMA_INTR_SOURCE IRQ_DEFAULT_PRIORITY 0>;
			interrupt-parent = <&intc>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";

			/*
			 * The endpoint cannot be left empty for a shield to fill
			 * in. edtlib enforces a binding's required properties
			 * whenever the node's own status is "okay", and status
			 * does not inherit from a parent (edtlib.py Node.status),
			 * so this endpoint is validated even though mipi_csi
			 * above is disabled - and images that never see a shield,
			 * MCUboot included, would fail the build.
			 *
			 * bus-type and data-lanes are properties of the board's
			 * connector rather than of any particular camera: J3 is
			 * the Raspberry Pi 15-pin CSI connector, wired
			 * CSI_D0_+/-, CSI_D1_+/- and CSI_CLK_+/- to the P4's
			 * dedicated D-PHY pads, i.e. 2-lane MIPI CSI-2 D-PHY.
			 * remote-endpoint-label is the one sensor-specific value,
			 * defaulted to the Raspberry Pi camera module's output
			 * endpoint; a shield for a different sensor overrides it.
			 */
			port {
				csi_ep_in: endpoint {
					remote-endpoint-label = "imx219_ep_out";
					bus-type = <VIDEO_BUS_TYPE_CSI2_DPHY>;
					data-lanes = <1 2>;
				};
			};
		};
	};
};

/*
 * The CSI connector's SCCB pins are i2c0 (SCL GPIO8 / SDA GPIO7), so the camera
 * shields' csi_i2c is this bus. Separate statement because the node already
 * carries the zephyr_i2c label above.
 */
csi_i2c: &i2c0 {};
