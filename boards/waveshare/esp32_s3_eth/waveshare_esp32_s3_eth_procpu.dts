 *
 * SPDX-License-Identifier: Apache-2.0
 *
 * Waveshare ESP32-S3-ETH: ESP32-S3-WROOM-1U-N16R8 (16MB flash, 8MB PSRAM)
 * with an onboard WIZnet W5500 10/100 Ethernet controller on SPI2.
 */
/dts-v1/;

#include <espressif/esp32s3/esp32s3.dtsi>
#include <espressif/partitions_0x0_amp_16M.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/led/led.h>
#include "waveshare_esp32_s3_eth-pinctrl.dtsi"

/ {
	model = "Waveshare ESP32-S3-ETH PROCPU";
	compatible = "espressif,esp32s3";

	aliases {
		watchdog0 = &wdt0;
		led-strip = &status_led;
		sw0 = &button0;
		sdhc0 = &sd0;
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "BOOT Button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	/* Single onboard WS2812B on GPIO21. It is an addressable LED, not a
	 * plain GPIO one, so it cannot be driven through the led-gpios/leds
	 * bindings -- it needs a 24-bit GRB frame at WS2812 timing, which the
	 * RMT peripheral generates via the vendor-neutral pulse_io API.
	 */
	status_led: ws2812 {
		compatible = "worldsemi,ws2812-pulse-io";
		pulse-ios = <&rmt 0>;
		chain-length = <1>;
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
		reset-delay = <300>;
	};

	chosen {
		zephyr,sram = &sram1;
		/* USB-C is the ESP32-S3 native USB-Serial/JTAG; UART0 (GPIO43/44)
		 * is not broken out to the port, so the console lives on USB. */
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,bt-hci = &esp32_bt_hci;
	};
};

/* ESP32-S3-WROOM-1U-N16R8: 16MB quad flash, 8MB octal PSRAM. The SoC dtsi no
 * longer carries per-module sizes, so the board states its own.
 */
&flash0 {
	reg = <0x0 DT_SIZE_M(16)>;
	ranges = <0x0 0x0 DT_SIZE_M(16)>;
};

&psram0 {
	size = <DT_SIZE_M(8)>;
};

&usb_serial {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spim2_w5500>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;

	ethernet: w5500@0 {
		compatible = "wiznet,w5500";
		reg = <0x0>;
		spi-max-frequency = <40000000>;
		int-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
		/* W5500 has no MAC EEPROM; assign a locally-administered address. */
		local-mac-address = [02 00 00 00 02 03];
		status = "okay";
	};
};

/* Onboard microSD/TF slot, wired in SPI mode. */
&spi3 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spim3_tf>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;

	sd0: sd@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0x0>;
		status = "okay";
		/* Cards negotiate up from 400kHz; 20MHz is the usual safe
		 * ceiling for an SPI-mode slot with no length-matched traces.
		 */
		spi-max-frequency = <20000000>;

		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
};

&rmt {
	pinctrl-0 = <&rmt_ws2812>;
	pinctrl-names = "default";
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&trng0 {
	status = "okay";
};

&esp32_bt_hci {
	status = "okay";
};

&wifi {
	status = "okay";
};

zephyr_udc0: &usb_otg {
	status = "okay";
};
