menuconfig ESPHOME_API
	bool "ESPHome native API server"
	depends on NET_SOCKETS
	depends on NET_TCP
	select NANOPB
	help
	  Server side of the ESPHome native API (TCP, protobuf messages,
	  optional Noise encryption, mDNS discovery) so Home Assistant can
	  discover the device and read and control its entities. Only the
	  networking protocol is implemented, not ESPHome's YAML/codegen.

if ESPHOME_API

config ESPHOME_API_PORT
	int "TCP port"
	default 6053

config ESPHOME_API_MAX_CLIENTS
	int "Maximum concurrent clients"
	default 2
	range 1 8

config ESPHOME_API_IDLE_TIMEOUT
	int "Idle timeout in seconds"
	default 90
	help
	  Close a client that has sent nothing for this long. Home Assistant
	  pings every 20 s and gives up on an unanswered ping after 90 s.

config ESPHOME_API_RX_BUF_SIZE
	int "Receive buffer per client"
	default 256
	help
	  Largest request frame accepted. The client requests this server
	  handles are all well under 128 bytes.

config ESPHOME_API_DEVICE_NAME
	string "Device name"
	default "zephyr"
	depends on !NET_HOSTNAME_ENABLE
	help
	  Hostname-style name (at most 31 characters) Home Assistant uses to
	  identify the device. Keep it stable. With NET_HOSTNAME_ENABLE the
	  hostname is used instead, so the name matches <hostname>.local.

config ESPHOME_API_FRIENDLY_NAME
	string "Friendly name"
	default ""

config ESPHOME_API_MANUFACTURER
	string "Manufacturer shown in Home Assistant"
	default "Zephyr"

config ESPHOME_API_MDNS
	bool "Advertise over mDNS"
	default y
	depends on MDNS_RESPONDER_DNS_SD
	help
	  Register an _esphomelib._tcp DNS-SD service, named after the
	  hostname, with the TXT keys Home Assistant's discovery reads
	  (friendly_name, version, mac, board, network). Needs
	  MDNS_RESPONDER, DNS_SD and NET_HOSTNAME_ENABLE.

config ESPHOME_API_NOISE
	bool "Noise encryption"
	select PSA_CRYPTO
	select PSA_WANT_ALG_CHACHA20_POLY1305
	select PSA_WANT_KEY_TYPE_CHACHA20
	select PSA_WANT_ALG_ECDH
	select PSA_WANT_ECC_MONTGOMERY_255
	select PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_GENERATE
	select PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_EXPORT
	select PSA_WANT_ALG_HMAC
	select PSA_WANT_KEY_TYPE_HMAC
	select PSA_WANT_ALG_SHA_256
	select BASE64
	help
	  Encrypt the connection with Noise_NNpsk0_25519_ChaChaPoly_SHA256, as
	  ESPHome's "api: encryption: key:" does. Plaintext clients are
	  refused. Set the 32-byte key with esphome_api_set_psk() (saved to
	  settings when CONFIG_SETTINGS is enabled; call settings_load() at
	  boot) or, for development, ESPHOME_API_NOISE_PSK. Until a key is
	  set every client is refused.

config ESPHOME_API_NOISE_PSK
	string "Encryption key (base64), development only"
	depends on ESPHOME_API_NOISE
	default ""
	help
	  Base64 of the 32-byte key, as Home Assistant asks for it. The key
	  ends up in the firmware image, so use esphome_api_set_psk() for
	  anything beyond development.

config ESPHOME_API_STACK_SIZE
	int "Server thread stack size"
	default 4096 if ESPHOME_API_NOISE
	default 2048

config ESPHOME_API_THREAD_PRIORITY
	int "Server thread priority"
	default 7

module = ESPHOME_API
module-str = esphome_api
source "subsys/logging/Kconfig.template.log_config"

endif # ESPHOME_API
