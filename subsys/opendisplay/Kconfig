DT_CHOSEN_ZEPHYR_DISPLAY := zephyr,display

menuconfig OPENDISPLAY
	bool "OpenDisplay device"
	depends on DISPLAY
	depends on $(dt_chosen_enabled,$(DT_CHOSEN_ZEPHYR_DISPLAY))
	select CRC
	help
	  Device side of the OpenDisplay protocol 2.2 (opendisplay.org), so
	  Home Assistant's opendisplay integration or py-opendisplay can read
	  the device config and push images to the zephyr,display device.

if OPENDISPLAY

config OPENDISPLAY_FW_VERSION_MAJOR
	int "Firmware version major"
	range 0 255
	default 1

config OPENDISPLAY_FW_VERSION_MINOR
	int "Firmware version minor"
	range 0 255
	default 0

config OPENDISPLAY_FW_VERSION_PATCH
	int "Firmware version patch"
	range 0 255
	default 0

config OPENDISPLAY_IC_TYPE
	int "SystemConfig ic_type"
	range 0 65535
	default 0
	help
	  Microcontroller id reported to hosts. 0 is "unknown"; hosts only
	  use it for display.

config OPENDISPLAY_MANUFACTURER_ID
	int "ManufacturerData manufacturer_id"
	range 0 65535
	default 0
	help
	  0 is DIY.

config OPENDISPLAY_BOARD_TYPE
	int "ManufacturerData board_type"
	range 0 255
	default 0

config OPENDISPLAY_POWER_MODE
	int "PowerOption power_mode"
	range 1 3
	default 2
	help
	  1 battery, 2 USB, 3 solar.

config OPENDISPLAY_CONFIG_BUF_SIZE
	int "Config buffer size"
	range 660 4096
	default 1024
	help
	  Holds the generated READ_CONFIG reply and a chunked WRITE_CONFIG
	  while it arrives. Larger written configs are refused. A config
	  with WiFi, security and extended identity packets plus the usual
	  hardware packets is about 650 bytes.

config OPENDISPLAY_BLE
	bool "BLE transport"
	depends on BT_PERIPHERAL
	help
	  GATT service 0x2446 with connectable advertising carrying the
	  manufacturer-specific data Home Assistant discovers. Start it with
	  opendisplay_ble_start() after bt_enable(). Hosts write up to 232-byte
	  frames, so the ATT MTU must reach 235: the defaults below raise the
	  ACL buffers and L2CAP MTU to 251/247.

if OPENDISPLAY_BLE

config OPENDISPLAY_BLE_RX_QUEUE
	int "Queued writes"
	default 4
	help
	  Writes waiting for the transport thread, each up to 253 bytes. Hosts
	  wait for the reply to each command, so a few are enough.

config OPENDISPLAY_BLE_STACK_SIZE
	int "Transport thread stack size"
	default 2048

config OPENDISPLAY_BLE_THREAD_PRIORITY
	int "Transport thread priority"
	default 7

endif # OPENDISPLAY_BLE

config OPENDISPLAY_LAN
	bool "LAN transport"
	depends on NET_SOCKETS
	help
	  TCP server for protocol 2.2's network transport: [len:2 LE][frame],
	  one client at a time (a new one evicts the old), dropped when idle.
	  Listens on the port the host wrote in WifiConfig, or
	  OPENDISPLAY_LAN_PORT, as soon as the stack is up. Needs a 4 KB
	  receive buffer: hosts send direct write chunks of 4092 bytes.

if OPENDISPLAY_LAN

config OPENDISPLAY_LAN_PORT
	int "Default TCP port"
	range 1 65534
	default 2446
	help
	  Used while the host-written WifiConfig server_port is 0.

config OPENDISPLAY_LAN_IDLE_TIMEOUT
	int "Idle timeout in seconds"
	default 30

config OPENDISPLAY_LAN_MDNS
	bool "Advertise over mDNS"
	default y
	depends on MDNS_RESPONDER_DNS_SD
	help
	  Register _opendisplay._tcp with TXT keys mac (the BLE address when
	  the BLE transport is on, else the interface MAC), tls, fw, cm and
	  pv. The instance is the hostname with NET_HOSTNAME_ENABLE, else
	  "opendisplay".

config OPENDISPLAY_LAN_STACK_SIZE
	int "Server thread stack size"
	default 4096 if OPENDISPLAY_SECURITY
	default 2048

config OPENDISPLAY_LAN_THREAD_PRIORITY
	int "Server thread priority"
	default 7

endif # OPENDISPLAY_LAN

config OPENDISPLAY_ZLIB
	bool "zlib compressed uploads"
	select UZLIB
	help
	  Accept zlib streams with a window of up to 512 bytes (what hosts
	  send) in direct write and PIPE_WRITE, decoded as they arrive.
	  About 2.8 KB of RAM. Advertised as streaming decompression.

config OPENDISPLAY_PIPE
	bool "PIPE_WRITE uploads"
	help
	  Sliding-window image transfer over BLE (0x0080-0x0082): the host
	  keeps up to 32 frames in flight and the device acknowledges every
	  few. Hosts that see it advertised use it in place of direct write.

config OPENDISPLAY_SECURITY
	bool "Encryption"
	depends on !OPENDISPLAY_LAN || NET_SOCKETS_SOCKOPT_TLS
	select PSA_CRYPTO
	select PSA_WANT_KEY_TYPE_AES
	select PSA_WANT_ALG_CMAC
	select PSA_WANT_ALG_CCM
	select PSA_WANT_ALG_ECB_NO_PADDING
	help
	  Honour the host-written SecurityConfig. While it is enabled with a
	  non-zero key, BLE hosts must pass AUTHENTICATE (0x0050) before any
	  command but FIRMWARE_VERSION, and frames are then AES-128-CCM
	  wrapped. The LAN transport serves only TLS 1.2 PSK on server_port
	  + 1, with identity "opendisplay" and a PSK derived from the key;
	  enable a PSK ciphersuite such as
	  MBEDTLS_CIPHERSUITE_TLS_PSK_WITH_AES_128_GCM_SHA256 for it.

config OPENDISPLAY_LAN_TLS_SEC_TAG
	int "TLS credential tag for the LAN PSK"
	depends on OPENDISPLAY_SECURITY && OPENDISPLAY_LAN
	default 2446

module = OPENDISPLAY
module-str = opendisplay
source "subsys/logging/Kconfig.template.log_config"

endif # OPENDISPLAY

if OPENDISPLAY_BLE

config BT_L2CAP_TX_MTU
	default 247

config BT_BUF_ACL_RX_SIZE
	default 251

config BT_BUF_ACL_TX_SIZE
	default 251

endif # OPENDISPLAY_BLE
