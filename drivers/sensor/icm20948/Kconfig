# ICM-20948 9-axis IMU configuration option

config ICM20948_OOT
	bool "TDK InvenSense ICM-20948 IMU over I2C (out-of-tree)"
	default y
	depends on DT_HAS_INVENSENSE_ICM20948_ENABLED
	depends on !ICM20948
	select I2C
	help
	  Enable this repository's driver for the ICM-20948 accelerometer and
	  gyroscope over I2C. The on-chip AK09916 magnetometer is not exposed;
	  it sits behind the part's own I2C master and nothing needs it yet.

	  Zephyr's in-tree driver (CONFIG_ICM20948) binds the same
	  "invensense,icm20948" compatible but supports SPI only, and builds
	  for every instance, so set CONFIG_ICM20948=n to use this one.
