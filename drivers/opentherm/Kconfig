config OPENTHERM
	bool "OpenTherm master over GPIO"
	default y
	depends on DT_HAS_OPENTHERM_GPIO_ENABLED
	depends on GPIO
	help
	  OpenTherm master (thermostat side) that bit-bangs the Manchester
	  line through an external OpenTherm adapter on two GPIOs. Half-bits
	  are clocked from a k_timer, so CONFIG_SYS_CLOCK_TICKS_PER_SEC must
	  be a multiple of 2000 (Espressif SoCs default to 1000; use 10000).
	  The GPIOs must be settable from an ISR (SoC GPIO, not an expander).

if OPENTHERM

config OPENTHERM_INIT_PRIORITY
	int "OpenTherm init priority"
	default 80
	help
	  Must be after the GPIO controllers.

module = OPENTHERM
module-str = opentherm
source "subsys/logging/Kconfig.template.log_config"

endif # OPENTHERM
