config VIDEO_ESP32_CSI
	bool "ESP32 MIPI CSI-2 camera receiver"
	default y
	depends on DT_HAS_ESPRESSIF_ESP_MIPI_CSI_ENABLED
	depends on SOC_SERIES_ESP32P4
	select CACHE_MANAGEMENT if CPU_HAS_DCACHE
	help
	  Enable the ESP32-P4 MIPI CSI-2 receiver video capture driver. It drives
	  the CSI D-PHY, host and bridge, and a DW-GDMA channel that streams
	  frames from a downstream CSI-2 image sensor into memory.

	  RAW8, RAW10 and RAW12 (Bayer or greyscale) are captured as they arrive
	  on the link. The ISP is only used as a passthrough, so frames are not
	  demosaiced.
